  "stats_definition": " SELECT d.id AS distributor_id,\n    d.company,\n    d.city,\n    d.credit_limit,\n    d.discount,\n    COALESCE(ach.achieved, 0::numeric) AS achieved,\n    COALESCE(t.amount, 0::numeric) AS target,\n    COALESCE(dbt.debt, 0::numeric) + d.debt_adjustment AS debt,\n    GREATEST(0::numeric, d.credit_limit - (COALESCE(dbt.debt, 0::numeric) + d.debt_adjustment)) AS remaining_limit\n   FROM distributors d\n     LEFT JOIN targets t ON t.distributor_id = d.id AND t.period = current_half_year()\n     LEFT JOIN LATERAL ( SELECT COALESCE(sum(ot.total), 0::numeric) AS achieved\n           FROM order_totals ot\n          WHERE ot.distributor_id = d.id AND ot.status = 'delivered'::text AND half_year_of(ot.created_at::date) = current_half_year()) ach ON true\n     LEFT JOIN LATERAL ( SELECT COALESCE(sum(ot.total), 0::numeric) - COALESCE(( SELECT sum(p.amount) AS sum\n                   FROM payments p\n                  WHERE p.distributor_id = d.id), 0::numeric) AS debt\n           FROM order_totals ot\n          WHERE ot.distributor_id = d.id AND (ot.status = ANY (ARRAY['pending'::text, 'confirmed'::text, 'shipped'::text, 'delivered'::text]))) dbt ON true;",
  "triggers": [
    "CREATE TRIGGER trg_set_order_code BEFORE INSERT ON public.orders FOR EACH ROW EXECUTE FUNCTION set_order_code()",
    "CREATE TRIGGER trg_sync_order_item_amount BEFORE INSERT OR UPDATE ON public.order_items FOR EACH ROW EXECUTE FUNCTION sync_order_item_amount()"
  ]
